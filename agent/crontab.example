# Self-audit schedule — runs ON THIS DEVICE.
# Install with: crontab agent/crontab.example   (edit paths first)
#
# Each run writes a dated report file locally. Load whichever one you want
# to review into the dashboard (drag-drop / file picker / paste). Nothing is
# uploaded — the dashboard reads the file in your browser.

# Nightly hardening + discovery audit at 02:00
0 2 * * * cd /opt/selfaudit && /usr/bin/python3 selfaudit.py --mode audit --out "/var/log/selfaudit/report-$(date +\%Y\%m\%d).json" >> /var/log/selfaudit/run.log 2>&1

# Weekly deeper scan on Sunday 03:00 (enable an optional engine in the agent)
0 3 * * 0 cd /opt/selfaudit && /usr/bin/python3 selfaudit.py --mode audit --engine openvas --out "/var/log/selfaudit/deep-$(date +\%Y\%m\%d).json" >> /var/log/selfaudit/run.log 2>&1

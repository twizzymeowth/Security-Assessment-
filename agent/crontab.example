# Weekly self-audit — runs ON THIS DEVICE, against this device.
# Install with: crontab agent/crontab.example   (edit the path first)
#
# Each run writes a timestamped report folder under output_dir (set in the
# config), e.g. ~/selfaudit-reports/2026-11-24_0200/{report.html,md,csv,json}.
# Open report.html and Save-as-PDF for the PDF.
#
# The defense-validation tests are intentionally NOT included here — keep them
# manual (run `selfaudit.py --validate` yourself when you want them).

# Sundays at 02:00
0 2 * * 0 cd /opt/selfaudit && /usr/bin/python3 selfaudit.py --config selfaudit.conf >> ~/selfaudit-reports/cron.log 2>&1
